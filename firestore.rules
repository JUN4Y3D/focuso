rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Guest Order validation
    function isValidGuestOrder(data) {
      return data.keys().hasAll([
        'id', 'orderRef', 'customerName', 'phone', 'city', 'address',
        'qty', 'subtotal', 'deliveryFee', 'total', 'paymentMethod', 'status', 'createdAt'
      ])
      && data.id is string && data.id.size() <= 128
      && data.orderRef is string && data.orderRef.size() <= 64
      && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 128
      && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32
      && data.city is string && data.city.size() > 0 && data.city.size() <= 64
      && data.address is string && data.address.size() > 0 && data.address.size() <= 500
      && data.qty is number && data.qty >= 1 && data.qty <= 99
      && data.subtotal is number && data.subtotal >= 0
      && data.deliveryFee is number && data.deliveryFee >= 0
      && data.total is number && data.total >= 0
      && data.paymentMethod is string && data.paymentMethod.size() <= 64
      && data.status is string && data.status.size() <= 32
      && data.createdAt is string && data.createdAt.size() <= 64
      && (!('discount' in data) || data.discount is number)
      && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    match /orders/{orderId} {
      // Allow guest checkout to create an order
      allow create: if isValidId(orderId) && isValidGuestOrder(incoming());
      // Disallow public listing/reading or modification for customer data privacy
      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
