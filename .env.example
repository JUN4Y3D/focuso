# Server-only — never expose these through VITE_ variables or commit real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BKASH_SEND_MONEY_NUMBER=

# Browser-safe — used only for the admin Supabase Auth client.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Runtime / deployment
PORT=
NODE_ENV=
ALLOWED_ORIGINS=
APP_URL=
FOCUSO_ENV=
ENABLE_FRAMEGUARD=
AI_STUDIO_PREVIEW=

# Remote integration tests — use an isolated Supabase project only.
# These tests refuse to run unless RUN_SUPABASE_INTEGRATION_TESTS=true and the
# active server variables below exactly match the dedicated test project.
RUN_SUPABASE_INTEGRATION_TESTS=false
SUPABASE_TEST_URL=
SUPABASE_TEST_SECRET_KEY=
SUPABASE_TEST_PUBLISHABLE_KEY=
