{
  "entities": {
    "GuestOrder": {
      "title": "Guest Order",
      "description": "Order placed by a guest customer for FOCUSO Daily Planner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderRef": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "qty": { "type": "number" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": [
        "id",
        "orderRef",
        "customerName",
        "phone",
        "city",
        "address",
        "qty",
        "subtotal",
        "deliveryFee",
        "total",
        "paymentMethod",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "GuestOrder",
      "description": "Guest orders placed directly through checkout"
    }
  }
}
