# Dedicated FOCUSO Supabase test project only. Never point these values at production.
RUN_SUPABASE_INTEGRATION_TESTS=true

# Dedicated test-project credentials
SUPABASE_TEST_URL=
SUPABASE_TEST_SECRET_KEY=
SUPABASE_TEST_PUBLISHABLE_KEY=

# Active server credentials must exactly match the test-project values above.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Active browser credentials must exactly match the test-project values above.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required by the Express server while exercising checkout and chat endpoints.
GEMINI_API_KEY=
BKASH_SEND_MONEY_NUMBER=

# Optional: address of the separately started local test server.
TEST_BASE_URL=http://127.0.0.1:3000
